msgid "Putuo intelligent software industry support, 2026"
msgstr "Programa especial para la industria de software inteligente de Putuo, 2026"

#: ../../funding/putuo-intelligent-software.rst:4
msgid "Grant / reimbursement | Putuo"
msgstr "Subvención / reembolso | Distrito de Putuo"

#: ../../funding/putuo-intelligent-software.rst:6
msgid "Closed"
msgstr "Plazo cerrado"

#: ../../funding/putuo-intelligent-software.rst:8

#| msgid ""
